{
  "name": "nihongo-quick-start",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "vercel:env:push": "node scripts/vercel-sync-env.mjs",
    "db:apply": "node scripts/apply-schema.mjs",
    "motion:preview": "npm --prefix hyperframes/cultural-recap run dev",
    "motion:check": "npm --prefix hyperframes/cultural-recap run check",
    "motion:render": "npm --prefix hyperframes/cultural-recap run render",
    "remotion:compositions": "remotion compositions remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts CulturalArticleRecap public/renders/cultural-article-recap.mp4",
    "remotion:still": "remotion still remotion/index.ts CulturalArticleRecap public/renders/cultural-article-recap-frame60.png --frame=60"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1048.0",
    "@google/generative-ai": "^0.24.1",
    "@gsap/react": "^2.1.2",
    "@remotion/player": "^4.0.471",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.7.3",
    "gsap": "^3.15.0",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "lucide-react": "^0.453.0",
    "motion": "^12.40.0",
    "next": "^16.2.7",
    "openai": "^4.68.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.471",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.471",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "hyperframes": "^0.6.70",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
